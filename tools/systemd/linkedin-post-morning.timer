[Unit]
Description=Social agent: the morning LinkedIn Page job list

[Timer]
# Same IST times as knowledge/linkedin.json slots.morning; tests/test_linkedin_growth.py checks they match.
OnCalendar=Mon *-*-* 09:47:00 Asia/Kolkata
OnCalendar=Tue *-*-* 09:47:00 Asia/Kolkata
OnCalendar=Wed *-*-* 09:47:00 Asia/Kolkata
OnCalendar=Thu *-*-* 09:47:00 Asia/Kolkata
OnCalendar=Fri *-*-* 09:47:00 Asia/Kolkata
OnCalendar=Sat *-*-* 11:47:00 Asia/Kolkata
OnCalendar=Sun *-*-* 10:47:00 Asia/Kolkata
AccuracySec=1s
# A slot missed while the VM was down stays missed: posting it hours late is what late_start prevents.
Persistent=false
Unit=linkedin-post@morning.service

[Install]
WantedBy=timers.target
